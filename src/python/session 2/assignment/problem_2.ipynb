   "source": [
    "name = input(\"Enter your name: \")\n",
    "def Are_you_playing_banjo(name):\n",
    "    if name[0] == \"R\" or name[0] == \"r\" :\n",
    "        return name + \" plays banjo\"\n",
    "    else:\n",
    "        return name + \" does not play banjo\"\n",
    "print(Are_you_playing_banjo(name))"
   ]
  }
